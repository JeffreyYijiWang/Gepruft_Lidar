# Copy to .env for Compose substitution. Never commit real tokens/passwords.
LMS_WEB_PORT=8000
LMS_ANGLE=180
LMS_RESOLUTION=1.0
LMS_UNIT=mm
LMS_SERIAL_DEVICE=/dev/ttyUSB0
# Linux: stat -c %g /dev/ttyUSB0
LMS_SERIAL_GID=20
LMS_SERIAL_STANDARD=rs232
LMS_TARGET_BAUD=38400
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
LMS_BRIDGE_TOKEN=
LMS_REPLAY_FILE=scan.bin
LMS_REPLAY_SPEED=1
